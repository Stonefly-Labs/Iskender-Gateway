<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\samples\Iskender.Samples.EmbeddedHost\Iskender.Samples.EmbeddedHost.csproj" />
    <ProjectReference Include="..\..\src\Iskender.Core.Contracts\Iskender.Core.Contracts.csproj" />
    <ProjectReference Include="..\..\src\Iskender.Domain\Iskender.Domain.csproj" />
    <ProjectReference Include="..\..\src\Iskender.Hosting\Iskender.Hosting.csproj" />
    <ProjectReference Include="..\..\src\Iskender.Infrastructure\Iskender.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\Iskender.Infrastructure.PostgreSql\Iskender.Infrastructure.PostgreSql.csproj" />
    <ProjectReference Include="..\..\src\Iskender.Infrastructure.Redis\Iskender.Infrastructure.Redis.csproj" />
    <ProjectReference Include="..\Iskender.Hosting.Testing\Iskender.Hosting.Testing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- ISK-0003's test schemas and fixture documents, reused by the start-up refusal tests (data-model "Test fixtures"). -->
  <ItemGroup>
    <Compile Include="..\Iskender.Domain.Tests\Configuration\TestSchemas.cs" Link="Fixtures\Isk0003\TestSchemas.cs" />
    <None Include="..\Iskender.Domain.Tests\Configuration\Fixtures\**\*" Link="Isk0003Fixtures\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- ISK-0004's PostgreSQL fixture, and only what it needs to compile, for the single-instance refusal (ISK-0007 T023). -->
  <ItemGroup>
    <Compile Include="..\Iskender.Infrastructure.PostgreSql.Tests\Fixture\PostgreSqlFixture.cs" Link="Fixtures\Isk0004\PostgreSqlFixture.cs" />
    <Compile Include="..\Iskender.Infrastructure.PostgreSql.Tests\Fixture\ClassDatabase.cs" Link="Fixtures\Isk0004\ClassDatabase.cs" />
    <Compile Include="..\Iskender.Infrastructure.PostgreSql.Tests\Fixture\RequirePostgreSql.cs" Link="Fixtures\Isk0004\RequirePostgreSql.cs" />
    <Compile Include="..\Iskender.Infrastructure.PostgreSql.Tests\Fixture\TestCredentialProvider.cs" Link="Fixtures\Isk0004\TestCredentialProvider.cs" />
    <Compile Include="..\Iskender.Infrastructure.PostgreSql.Tests\Fixture\TestSettings.cs" Link="Fixtures\Isk0004\TestSettings.cs" />
    <Compile Include="..\Iskender.Infrastructure.PostgreSql.Tests\Fixture\CapturingDiagnostics.cs" Link="Fixtures\Isk0004\CapturingDiagnostics.cs" />
    <Compile Include="..\Iskender.Infrastructure.PostgreSql.Tests\Modules\FixtureModules.cs" Link="Fixtures\Isk0004\FixtureModules.cs" />
    <EmbeddedResource Include="..\Iskender.Infrastructure.PostgreSql.Tests\Fixture\init-roles.sql" Link="Fixtures\Isk0004\init-roles.sql" />
    <!-- FixtureModules finds its migrations by ISK-0004's manifest names, so they keep them here. -->
    <EmbeddedResource Include="..\Iskender.Infrastructure.PostgreSql.Tests\Modules\**\*.sql" Link="Fixtures\Isk0004\Modules\%(RecursiveDir)%(Filename)%(Extension)" LogicalName="Iskender.Infrastructure.PostgreSql.Tests.Modules.$([System.String]::Copy('%(RecursiveDir)').Replace('\', '.').Replace('/', '.'))%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
