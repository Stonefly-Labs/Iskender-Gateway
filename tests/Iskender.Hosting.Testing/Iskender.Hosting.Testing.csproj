<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The hosting test fixture (research R17): an in-process embedded host on a TestServer and a captured logger, shared by
    the hosting tests and the infrastructure test projects that start a host. It is a class library, not a test
    executable, and is not packable.
  -->

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
    <PackageReference Include="xunit.v3.assert" />
    <PackageReference Include="xunit.v3.extensibility.core" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Iskender.Core.Contracts\Iskender.Core.Contracts.csproj" />
    <ProjectReference Include="..\..\src\Iskender.Hosting\Iskender.Hosting.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
