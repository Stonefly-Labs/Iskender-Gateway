  "rules": [
    {
      "id": "A1",
      "statement": "Iskender.Core.Contracts references no other Iskender.* project.",
      "source": "Baseline, FR-010",
      "retired": false
    },
    {
      "id": "A2",
      "statement": "No project, test projects included, reaches Iskender.Gateway.Host or Iskender.ControlPlane.Host.",
      "source": "Baseline, FR-010, FR-014",
      "retired": false
    },
    {
      "id": "A3",
      "statement": "Iskender.Domain, Iskender.Providers.Abstractions, Iskender.Providers.<Provider>, Iskender.Policy.Sdk, and Iskender.Management do not reach Iskender.Infrastructure or an infrastructure adapter.",
      "source": "Baseline, FR-010, FR-011",
      "retired": false
    },
    {
      "id": "A4",
      "statement": "The whole project graph has no reference cycles.",
      "source": "Baseline, FR-010",
      "retired": false
    },
    {
      "id": "A5",
      "statement": "A production project references only what the approved references allow, and every production project is listed or matches a pattern.",
      "source": "Baseline, FR-009, FR-010",
      "retired": false
    },
    {
      "id": "A6",
      "statement": "Iskender.Gateway.Host reaches neither Iskender.Management nor Iskender.ControlPlane.Host.",
      "source": "FR-011",
      "retired": false
    },
    {
      "id": "A7",
      "statement": "Iskender.ControlPlane.Host reaches neither Iskender.Hosting nor Iskender.Gateway.Host.",
      "source": "FR-011",
      "retired": false
    },
    {
      "id": "A8",
      "statement": "Iskender.Hosting reaches neither Iskender.Infrastructure, an infrastructure adapter, nor Iskender.Management.",
      "source": "FR-011",
      "retired": false
    },
    {
      "id": "A9",
      "statement": "Iskender.Domain, Iskender.Policy.Sdk, and Iskender.Providers.* reach neither Iskender.Management, Iskender.Hosting, nor a host.",
      "source": "FR-011",
      "retired": false
    },
    {
      "id": "A10",
      "statement": "Iskender.Domain and Iskender.Hosting do not reach a provider adapter.",
      "source": "FR-011",
      "retired": false
    },
    {
      "id": "A11",
      "statement": "Iskender.Infrastructure does not reach an infrastructure adapter.",
      "source": "FR-011",
      "retired": false
    },
    {
      "id": "A12",
      "statement": "Iskender.Gateway.Host references Iskender.Hosting and Iskender.Infrastructure, and Iskender.ControlPlane.Host references Iskender.Management and Iskender.Infrastructure.",
      "source": "FR-012",
      "retired": false
    },
    {
      "id": "A13",
      "statement": "Every project reference and import resolves to a file in the repository, and every SDK is approved. Conditions are ignored, so every branch counts, and the root build files count as imports of every project. No project takes a direct assembly reference to, or a package named like, an Iskender.* project. Every project listed in Iskender.sln was scanned.",
      "source": "FR-013",
      "retired": false
    },
    {
      "id": "A14",
      "statement": "Every project is under src/ or tests/, no project under src/ is named *.Tests, and no two project files share a name, ignoring case.",
      "source": "FR-013, FR-014",
      "retired": false
    },
    {
      "id": "A15",
      "statement": "A production project's assembly name, root namespace, and package ID equal its project name.",
      "source": "FR-015",
      "retired": false
    },
    {
      "id": "A16",
      "statement": "A production assembly grants InternalsVisibleTo only to a test project.",
      "source": "FR-016",
      "retired": false
    },
    {
      "id": "A17",
      "statement": "A type in an Iskender.Domain module namespace uses no type in another module's namespace, unless the module allow-list permits it.",
      "source": "FR-017",
      "retired": false
    },
    {
      "id": "A18",
      "statement": "Every type in Iskender.Domain is in a mapped namespace or Iskender.Domain.Ports, and Iskender.Domain.Ports uses no module namespace.",
      "source": "FR-017",
      "retired": false
    },
    {
      "id": "A19",
      "statement": "A production project takes no package, framework reference, or SDK that its role denies, directly or transitively.",
      "source": "FR-018",
      "retired": false
    },
    {
      "id": "B1",
      "statement": "Every project takes package versions only from central management.",
      "source": "FR-019",
      "retired": false
    },
    {
      "id": "B2",
      "statement": "Every project has a committed lock file.",
      "source": "FR-020",
      "retired": false
    },
    {
      "id": "B3",
      "statement": "The root build files set the pinned analyzer baseline and every other required setting exactly once, with its required value and no condition, including central management, transitive pinning, and disabled version overrides.",
      "source": "FR-019, FR-020, FR-021, FR-022",
      "retired": false
    },
    {
      "id": "B4",
      "statement": "No required setting appears outside the root build files, under any condition, in a target, or in a nested configuration file, and no forbidden setting or item appears anywhere, the root build files included.",
      "source": "FR-022",
      "retired": false
    },
    {
      "id": "B5",
      "statement": "No tracked source file disables nullable checks, by a directive or by being treated as generated code.",
      "source": "FR-022",
      "retired": false
    },
    {
      "id": "B6",
      "statement": "Every warning suppression, in a project, source, or configuration file, is listed below.",
      "source": "FR-023",
      "retired": false
    },
    {
      "id": "P1",
      "statement": "Every project has a role, and a project is packable exactly when its role says so.",
      "source": "FR-025",
      "retired": false
    },
    {
      "id": "P2",
      "statement": "Every project reference from a packable project targets a packable project.",
      "source": "FR-026",
      "retired": false
    },
    {
      "id": "P3",
      "statement": "Every Iskender.* dependency of every package in a pack of the solution is also in the pack's output.",
      "source": "SC-007",
      "retired": false
    },
    {
      "id": "M1",
      "statement": "Each module in the docs/03 Module boundaries table has exactly one map entry, with no missing, extra, or duplicate entries.",
      "source": "FR-005, FR-007",
      "retired": false
    },
    {
      "id": "M2",
      "statement": "Each map and port entry names an existing project, an approved pattern, or a namespace under Iskender.Domain that the module map or the module namespaces section defines.",
      "source": "FR-005, FR-006",
      "retired": false
    },
